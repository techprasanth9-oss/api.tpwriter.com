# MongoDB Atlas SRV string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/tp-writer

# At least 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated FE origins allowed to call the API with cookies.
# `*` is accepted in development only; the server refuses to boot with it in production.
CORS_ORIGINS=http://localhost:3000

PORT=3001
NODE_ENV=development

# Set to true only when running behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# ── Server-side PDF export (optional) ─────────────────────────────────
# Public URL of the frontend. POST /documents/:id/pdf opens
# ${APP_URL}/documents/:id/print in headless Chromium with the caller's
# session. Leave empty to disable (the endpoint answers 501).
APP_URL=
# The URL the frontend uses for this API, if it isn't same-origin with
# APP_URL (e.g. https://api.example.com). Optional.
API_PUBLIC_URL=
# Chromium/Chrome executable. Empty → playwright-core's default install
# (`npx playwright-core install chromium`).
CHROMIUM_PATH=
# Max simultaneous renders.
PDF_CONCURRENCY=2
